{
  "manifest_version": 3,
  "name": "Reloadstar",
  "description": "Auto-refresh a tab on your schedule, with an optional idle-sleep blocker.",
  "version": "1.0.3",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "storage"
  ],
  "optional_permissions": [
    "power"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Reloadstar",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
